<?xml version="1.0" encoding="utf-8" ?>
<!--
  NLog: קובץ יומי (logs/babylink-DATE.log) + קונסול. כל שורה כוללת CorrelationId (מה-Logging Scope).
  Microsoft.* רק מ-Warning; הקוד שלנו מהרמה שב-NLogSettings:MinLevel (Debug בפיתוח, Info בייצור).
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <variable name="minLevel" value="${configsetting:item=NLogSettings.MinLevel:default=Info}" />
  <variable name="lineLayout"
            value="${longdate}|${level:uppercase=true}|${logger}|${scopeproperty:CorrelationId:whenEmpty=-}|${message}${onexception:inner= ${exception:format=tostring}}" />

  <targets>
    <target xsi:type="File" name="file"
            fileName="${basedir}/logs/babylink-${shortdate}.log"
            layout="${var:lineLayout}"
            encoding="utf-8" />
    <target xsi:type="Console" name="console" layout="${var:lineLayout}" />
  </targets>

  <rules>
    <!-- "Now listening on..." בעליית השרת -->
    <logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="console,file" final="true" />
    <!-- רעש של Microsoft מתחת ל-Warning נזרק -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />
    <logger name="*" minlevel="${var:minLevel}" writeTo="console,file" />
  </rules>
</nlog>
