// הגדרות משותפות לכל הסביבות - הקובץ נכנס ל-Git, ולכן אין כאן שום סוד!
// יתווספו: "Jwt": { "Issuer", "Audience", "ExpirationMinutes" } (בלי Key),
//          "Cors": { "AllowedOrigins": [...] } (כתובת הלקוח),
//          "ConnectionStrings": { "Default": "" } (ריק - הערך האמיתי ב-User Secrets / משתני סביבה ב-Render).
// הערה: הלוגים מוגדרים ב-nlog.config.
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
