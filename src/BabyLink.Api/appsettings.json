// הגדרות משותפות לכל הסביבות. הקובץ נכנס ל-Git - אין כאן סודות!
// ConnectionStrings:Default ו-Jwt:Key נשמרים ב-User Secrets (מקומי) / משתני סביבה (Render). הלוגים מוגדרים ב-nlog.config.
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "BabyLink.Api",
    "Audience": "BabyLink.Client",
    "ExpirationMinutes": 120
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "NLogSettings": {
    "MinLevel": "Info"
  }
}
