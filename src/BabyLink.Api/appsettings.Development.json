// הגדרות לסביבת פיתוח בלבד (דורסות את appsettings.json).
// גם כאן אין סודות - Jwt:Key ו-ConnectionStrings:Default נשמרים ב-User Secrets:
//   dotnet user-secrets set "ConnectionStrings:Default" "Host=localhost;Port=5432;Database=BabyLinkDb;Username=postgres;Password=***" --project src/BabyLink.Api
//   dotnet user-secrets set "Jwt:Key" "<מחרוזת אקראית ארוכה>" --project src/BabyLink.Api
// יתווסף: Cors:AllowedOrigins עם http://localhost:5173 (הלקוח המקומי), רמת לוג Debug.
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
